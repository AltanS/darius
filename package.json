{
  "name": "darius",
  "version": "0.66.0",
  "license": "MIT",
  "private": true,
  "description": "Rituals, vigils and milestones for agent-driven projects, synced to your own object storage",
  "type": "module",
  "bin": { "darius": "./bin/darius" },
  "scripts": {
    "check": "bun run lint && bun x tsc --noEmit && bun x tsc -p src/legacy && bun run test",
    "test:legacy": "cd src/legacy && node ../../node_modules/vitest/vitest.mjs run",
    "test": "bash scripts/test.sh",
    "typecheck": "bun x tsc --noEmit",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "darius": "bun src/cli.ts",
    "web:dev": "cd web && bun server/dev.ts",
    "web:build": "cd web && bun run build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "fast-check": "^3.22.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  }
}
