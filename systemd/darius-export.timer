# systemd/darius-export.timer: 03:30 local time daily, with up to 10 minutes of
# random delay. Persistent=true: if the host is asleep or powered off at 03:30,
# run once at the next boot, so a night off still leaves a backup.
[Unit]
Description=Run darius export once a day
Documentation=https://github.com/AltanS/darius

[Timer]
OnCalendar=03:30
RandomizedDelaySec=10min
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
