# systemd/darius-snapshot.timer: 04:00 local time daily, with up to 10 minutes
# of random delay (the git export runs at 03:30). Persistent=true: if the host
# is asleep or powered off at 04:00, run once at the next boot.
[Unit]
Description=Run darius snapshot once a day
Documentation=https://github.com/AltanS/darius

[Timer]
OnCalendar=04:00
RandomizedDelaySec=10min
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
