# systemd/darius-export.service: mirrors this host's store into the backup git
# repo from config.toml [backup], then commits and pushes. Triggered by
# darius-export.timer. Type=oneshot for the same reason as darius-sync.service:
# one CLI invocation, not a server. A template like darius-sync.service:
# `darius setup --systemd` fills in its PATH and DARIUS placeholders.
# `darius setup --systemd` installs it only when [backup] repo is set.
# git runs with no prompt: the push needs a key the host can use unattended.
[Unit]
Description=darius export
Documentation=https://github.com/AltanS/darius

[Service]
Type=oneshot
Environment="PATH=@PATH@"
ExecStart=@DARIUS@ export --json
